# Companion UW option-trades -> hot flow ledger.
# Does NOT place orders or emit webhooks. Does NOT modify trading-desk-tape sit_match.
# FLOW_LEDGER_PATH is non-secret. Never embed tokens in this unit.
# Example only — not copied/enabled by install_helsinki.sh. Merge ≠ Helsinki restart.
#
# Least privilege (H5): User=tradingdesk (not root).
# Writable: /var/lib/trading-desk/ledger (uw_flow.sqlite).
# Env: systemd reads /etc/trading-desk/unusual-whales.env (root 0600) before drop.
# This unit never emits webhooks — no grok-webhook.env.

[Unit]
Description=GrokTrading UW flow ledger companion (append-only; never orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingdesk
Group=tradingdesk
WorkingDirectory=/opt/groktrading
EnvironmentFile=-/etc/trading-desk/unusual-whales.env
Environment=FLOW_LEDGER_PATH=/var/lib/trading-desk/ledger/uw_flow.sqlite
Environment=FLOW_LEDGER_POLL_SEC=8
ExecStart=/opt/groktrading/.venv/bin/python /opt/groktrading/scripts/flow_ledger_companion.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
