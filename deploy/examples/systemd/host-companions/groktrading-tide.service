# Example host companion unit. NOT installed or enabled by install_helsinki.sh.
# Operator-wired only. Merge ≠ Helsinki restart.
# Account-events stays files-only / disabled.
# emit_sit_match=False. Never places orders. Do not embed tokens.
# Authorization Bearer is runtime env only (unusual-whales.env).

[Unit]
Description=GrokTrading host companion: UW market-tide / net-prem (no sit_match)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingdesk
Group=tradingdesk
WorkingDirectory=/opt/groktrading
EnvironmentFile=-/etc/trading-desk/groktrading.env
EnvironmentFile=-/etc/trading-desk/unusual-whales.env
ExecStart=/opt/groktrading/.venv/bin/python /opt/groktrading/scripts/tide_companion.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
