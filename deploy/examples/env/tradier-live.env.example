# Tradier production — never commit. Mode 0600.
# REST: https://api.tradier.com/v1/
# Stream: https://stream.tradier.com/v1/
# Account events: wss://ws.tradier.com
# Production NBBO is pricing truth. This repo never enables live orders by default.

TRADIER_ENV=production
TRADIER_ACCESS_TOKEN=YOUR_TRADIER_PRODUCTION_TOKEN
TRADIER_ACCOUNT_ID=YOUR_PRODUCTION_ACCOUNT_ID
TRADIER_REST_BASE=https://api.tradier.com/v1
GROKTRADING_MODE=signals_only
GROKTRADING_LIVE_EXPLICITLY_ENABLED=false
# P1 quote-interest set (host wires ws_tape.py). P2 shadow marks. Not secrets.
# TRADIER_QUOTE_WATCH_BOUND=40
# TRADIER_QUOTE_IDLE_TTL_SEC=900
# SHADOW_MARK_SEC=60
# ACCOUNT_EVENTS_ENABLED=0
