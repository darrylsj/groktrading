# Unusual Whales — never commit the real file. Mode 0600, root-only preferred.
# Official docs: https://api.unusualwhales.com/
# Agent endpoint index: https://unusualwhales.com/skill.md
# Base URL is configurable. Do not invent unofficial paths.

UW_API_TOKEN=YOUR_UNUSUAL_WHALES_TOKEN
UW_BASE_URL=https://api.unusualwhales.com
# Supply only paths published in the official docs, for example /api/option-trades
UW_OPTION_TRADES_PATH=/api/option-trades
# P1 documented paths (unusualwhales.com/skill.md). Not secrets.
# UW_FLOW_ALERTS_PATH=/api/option-trades/flow-alerts
# FLOW_ALERTS_POLL_SEC=20
# TIDE_POLL_SEC=180
# SCREENER_POLL_SEC=600
# Prove UW WebSocket only if the plan supports it. Fail-closed if unset.
# Fetch live channel docs before any host subscribe. Do not invent a protocol.
# UW_WS_URL=
