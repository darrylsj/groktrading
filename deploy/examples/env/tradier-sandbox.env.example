# Tradier sandbox / paper — never commit. Mode 0600.
# REST: https://sandbox.tradier.com/v1/
# Account events: wss://sandbox-ws.tradier.com
# Sandbox market data is delayed (~15 minutes). No market-data stream, no Greeks,
# no indices, no tick timesales. Account-event streaming is available.
# Do not use sandbox quotes as pricing truth; reconcile against production NBBO.

TRADIER_ENV=sandbox
TRADIER_ACCESS_TOKEN=YOUR_TRADIER_SANDBOX_TOKEN
TRADIER_ACCOUNT_ID=YOUR_SANDBOX_ACCOUNT_ID
TRADIER_REST_BASE=https://sandbox.tradier.com/v1
GROKTRADING_MODE=paper
GROKTRADING_LIVE_EXPLICITLY_ENABLED=false
