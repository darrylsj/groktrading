# Finnhub — never commit the real file. Install as /etc/trading-desk/finnhub.env
# owner root (or the service user), mode 0600.
# Finnhub does not provide option NBBO. Plan limits vary.

FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
FINNHUB_WS_URL=wss://ws.finnhub.io
FINNHUB_REST_BASE=https://finnhub.io/api/v1
FINNHUB_WATCHLIST=SPY,QQQ
# P2 watch widen (16–40) for open-risk / fresh-flow names. Finnhub ≠ option NBBO.
# FINNHUB_WATCH_WIDEN_CAP=32
GROKTRADING_MODE=signals_only
