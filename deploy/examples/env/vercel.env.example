# Vercel deploy knobs for the Helsinki live-board refresh companion.
# Install as /etc/trading-desk/vercel.env owner root, mode 0600.
# Never commit a filled copy. The installer never copies or prints this.
# Missing VERCEL_TOKEN: companion writes local artifacts and exits 0.

VERCEL_TOKEN=YOUR_VERCEL_TOKEN
VERCEL_ORG_ID=YOUR_VERCEL_ORG_ID
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID
# Non-secret project slug. Token / org / project id stay YOUR_* placeholders.
VERCEL_PROJECT_NAME=trading-desk-live-board
