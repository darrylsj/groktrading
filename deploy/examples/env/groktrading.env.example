# Package-wide mode flags — never commit a filled copy.
# Install as /etc/trading-desk/groktrading.env owner root, mode 0600.
# The installer never sets live. Default remains signals_only.
# WebSocket never places orders. Sandbox ≠ live fill evidence.

GROKTRADING_MODE=signals_only
GROKTRADING_LIVE_EXPLICITLY_ENABLED=false
# Sensor-farm state (package helpers). Merge ≠ Helsinki restart.
# STATE_DIR=/var/lib/trading-desk
# FLOW_LEDGER_PATH=/var/lib/trading-desk/ledger/uw_flow.sqlite
# SIT_MATCH_MAX_AGE_SEC=60
# ACCOUNT_EVENTS_ENABLED=0
