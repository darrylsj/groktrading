# Observed Helsinki /opt/trading-desk/.env — KEY NAMES only.
# Install as /opt/trading-desk/.env owner root, mode 0600.
# Never commit a filled copy. Prefer scp of the live file (docs/REBUILD_NEW_PROVIDER.md).
# These names match the hand-built host, not the package TRADIER_REST_BASE / UW_API_TOKEN helpers.
# WebSocket never places orders. Default remains signals_only until explicit live.

TRADIER_ACCOUNT_ID=YOUR_TRADIER_ACCOUNT_ID
TRADIER_ACCESS_TOKEN=YOUR_TRADIER_ACCESS_TOKEN
TRADIER_API_BASE=YOUR_TRADIER_API_BASE
UW_API_KEY=YOUR_UW_API_KEY
TAPE_OUT=YOUR_TAPE_OUT
FLOW_SEC=YOUR_FLOW_SEC
# sit_match freshness (UW option-trades executed_at). Default 60s. Fail closed if
# executed_at is missing or unparseable. Not a secret. After changing this on
# Helsinki, restart trading-desk-tape (operator-authorized).
# SIT_MATCH_MAX_AGE_SEC=60
#
# Helsinki sensor farm (package helpers; host-owned ws_tape.py unchanged).
# Hot UW flow ledger (SQLite). 7–14 day keep-hot window. Not a secret.
# FLOW_LEDGER_PATH=/var/lib/trading-desk/ledger/uw_flow.sqlite
# FLOW_LEDGER_KEEP_HOT_DAYS=7
# Box Trading Desk Archive cold-rotate. Folder id is not a token; still do not
# commit a live id. Never upload .env / credentials. Delete only after verify
# or --confirm-delete. scripts/box_cold_rotate.py
# BOX_ROTATE_KEEP_HOT_DAYS=7
# BOX_ARCHIVE_PARENT=YOUR_BOX_TRADING_DESK_ARCHIVE_FOLDER
# Tradier account-events WS = position truth only. Never places orders.
# Installer copies groktrading-account-events.service as files only.
# ACCOUNT_EVENTS_ENABLED=0
