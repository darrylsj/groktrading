# Schwab Trader API Individual — placeholders only. Never commit filled values.
# App status must be Ready For Use (Submitted is not enough).
# Callback URL in the Schwab developer portal must be exactly:
#   https://127.0.0.1:8182
# (no trailing slash). Access tokens last ~30 minutes; refresh tokens ~7 days.
# Copy App Key / App Secret to a secret store, then:
#   python -m groktrading.brokers.schwab_oauth
# Token file default (outside the repo): ~/.config/groktrading/schwab_token.json
# WebSocket events must never place orders.

SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_TOKEN_PATH=
